    "We require two-factor authentication for all staff members. Scan this QR code with Google Authenticator or Apple Passwords." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نطلب مصادقة ثنائية العامل لجميع أعضاء الموظفين. امسح رمز QR هذا باستخدام Google Authenticator أو Apple Passwords."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We require two-factor authentication for all staff members. Scan this QR code with Google Authenticator or Apple Passwords."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমাদের সমস্ত কর্মী সদস্যের জন্য দ্বি-ফ্যাক্টর প্রমাণীকরণ প্রয়োজন। গুগল প্রমাণীকরণ বা অ্যাপল পাসওয়ার্ড দিয়ে এই QR কোডটি স্ক্যান করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We require two-factor authentication for all staff members. Scan this QR code with Google Authenticator or Apple Passwords."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We require two-factor authentication for all staff members. Scan this QR code with Google Authenticator or Apple Passwords."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous exigeons une authentification à deux facteurs pour tous les membres du personnel. Scannez ce QR code avec Google Authenticator ou Apple Passwords."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અમને તમામ સ્ટાફ સભ્યો માટે બે-પરિબળ પ્રમાણીકરણની જરૂર છે. ગૂગલ ઓથેન્ટિકેટર અથવા એપલ પાસવર્ડ્સ સાથે આ ક્યૂઆર કોડને સ્કેન કરો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमें सभी स्टाफ सदस्यों के लिए दो-कारक प्रमाणीकरण की आवश्यकता है। इस QR कोड को Google प्रमाणक या Apple पासवर्ड से स्कैन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiediamo l'autenticazione a due fattori per tutti i membri dello staff. Scansiona questo codice QR con Google Authenticator o password Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
