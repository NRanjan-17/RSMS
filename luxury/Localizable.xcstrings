        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ഓർഡർ നിറവേറ്റാൻ ആവശ്യമായ ഇനങ്ങൾ ഇൻവെന്ററിയിലുണ്ട്."
