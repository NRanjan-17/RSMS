        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடவுச்சொல் மீட்டமைப்பு இணைப்பு உங்கள் மின்னஞ்சல் முகவரிக்கு அனுப்பப்பட்டுள்ளது."
          }
        },
        "te" : {
          "stringUnit" : {
