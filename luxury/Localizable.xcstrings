        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પેરિસ મેનેજરની પરવાનગીની રાહ જોતી કોઈ આવનારી વિનંતીઓ નથી."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेरिस प्रबंधक की अनुमति के लिए कोई अनुरोध प्रतीक्षित नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
