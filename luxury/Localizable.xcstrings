    "I agree to the internal policies, data privacy agreement, and terms of service required for system access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوافق على السياسات الداخلية، اتفاقية خصوصية البيانات، وشروط الخدمة المطلوبة للوصول إلى النظام."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I agree to the internal policies, data privacy agreement, and terms of service required for system access."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি সিস্টেম অ্যাক্সেসের জন্য প্রয়োজনীয় অভ্যন্তরীণ নীতিগুলি, তথ্য গোপনীয়তা চুক্তি এবং পরিষেবার শর্তাবলীর সাথে সম্মত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I agree to the internal policies, data privacy agreement, and terms of service required for system access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I agree to the internal policies, data privacy agreement, and terms of service required for system access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’accepte les politiques internes, l’accord de confidentialité des données et les conditions d’utilisation requises pour l’accès au système."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હું આંતરિક નીતિઓ, ડેટા ગોપનીયતા કરાર અને સિસ્ટમ ઍક્સેસ માટે જરૂરી સેવાની શરતો સાથે સંમત છું."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं आंतरिक नीतियों, डेटा गोपनीयता समझौते और सिस्टम एक्सेस के लिए आवश्यक सेवा की शर्तों से सहमत हूं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetto le politiche interne, l'accordo sulla privacy dei dati e i termini di servizio richiesti per l'accesso al sistema."
          }
        },
        "ja" : {
