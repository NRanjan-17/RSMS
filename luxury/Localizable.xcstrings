          "stringUnit" : {
            "state" : "translated",
            "value" : "この注文に対応するのに十分な在庫があります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಆರ್ಡರ್ ಪೂರೈಸಲು ದಾಸ್ತಾನಿನಲ್ಲಿ ಸಾಕಷ್ಟು ವಸ್ತುಗಳು ಇವೆ."
