        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ಯಾರಿಸ್ ವ್ಯವಸ್ಥಾಪಕರ ಅನುಮತಿಗಾಗಿ ಯಾವುದೇ ಒಳಬರುವ ವಿನಂತಿಗಳು ಕಾಯುತ್ತಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
