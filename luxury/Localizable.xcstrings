    "Enough items in inventory to fulfill this order." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد في المخزون ما يكفي من الأصناف لتلبية هذا الطلب."
