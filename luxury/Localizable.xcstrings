        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गणना प्रस्तुत कर दी गई है। इन्वेंट्री रिकॉर्ड सफलतापूर्वक अपडेट हो गया है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conteggio inviato. Record di inventario aggiornato correttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数量を送信しました。在庫記録が正常に更新されました。"
