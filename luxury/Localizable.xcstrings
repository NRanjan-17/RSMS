        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponemos de suficientes artículos en inventario para completar este pedido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons suffisamment d'articles en stock pour honorer cette commande."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ઓર્ડર પૂરો કરવા માટે પૂરતી વસ્તુઓ ઇન્વેન્ટરીમાં છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ऑर्डर को पूरा करने के लिए स्टॉक में पर्याप्त सामान मौजूद है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo articoli sufficienti in magazzino per evadere questo ordine."
          }
