        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಎಣಿಕೆ ಸಲ್ಲಿಸಲಾಗಿದೆ. ದಾಸ್ತಾನು ದಾಖಲೆಯನ್ನು ಯಶಸ್ವಿಯಾಗಿ ನವೀಕರಿಸಲಾಗಿದೆ."
          }
