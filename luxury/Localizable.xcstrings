    "Decision timestamp, manager identity, and request snapshot will be securely stored." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تخزين الطابع الزمني للقرار وهوية المدير ولقطة الطلب بشكل آمن."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিদ্ধান্ত টাইমষ্টেম্প, ব্যৱস্থাপক পৰিচয়, আৰু অনুৰোধ স্নেপশ্বট সুৰক্ষিতভাৱে সংৰক্ষণ কৰা হব।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিদ্ধান্তের টাইমস্ট্যাম্প, ম্যানেজারের পরিচয় এবং অনুরোধের স্ন্যাপশট নিরাপদে সংরক্ষণ করা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entscheidungszeitpunkt, Manageridentität und Anforderungs-Snapshot werden sicher gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La marca de tiempo de la decisión, la identidad del administrador y una instantánea de la solicitud se almacenarán de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’horodatage de la décision, l’identité du responsable et un instantané de la requête seront stockés en toute sécurité."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નિર્ણયનો સમયપત્રક, મેનેજર ઓળખ અને વિનંતીનો સ્નેપશોટ સુરક્ષિત રીતે સંગ્રહિત કરવામાં આવશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्णय का समय, प्रबंधक की पहचान और अनुरोध का स्नैपशॉट सुरक्षित रूप से संग्रहीत किया जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La data e l'ora della decisione, l'identità del responsabile e l'istantanea della richiesta verranno archiviate in modo sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決定のタイムスタンプ、管理者ID、およびリクエストのスナップショットは安全に保存されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿರ್ಧಾರ ಸಮಯಸ್ಟ್ಯಾಂಪ್, ವ್ಯವಸ್ಥಾಪಕರ ಗುರುತು ಮತ್ತು ವಿನಂತಿ ಸ್ನ್ಯಾಪ್‌ಶಾಟ್ ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결정 타임스탬프, 관리자 신원 및 요청 스냅샷은 안전하게 저장됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തീരുമാന ടൈംസ്റ്റാമ്പ്, മാനേജർ ഐഡന്റിറ്റി, അഭ്യർത്ഥന സ്നാപ്പ്ഷോട്ട് എന്നിവ സുരക്ഷിതമായി സൂക്ഷിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्णयाची वेळ, व्यवस्थापकाची ओळख आणि विनंतीचा स्नॅपशॉट सुरक्षितपणे संग्रहित केला जाईल."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନିଷ୍ପତ୍ତି ସମୟସୀମା, ପରିଚାଳକ ପରିଚୟ, ଏବଂ ଅନୁରୋଧ ସ୍ନାପସଟ୍ ସୁରକ୍ଷିତ ଭାବରେ ସଂରକ୍ଷଣ କରାଯିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਫੈਸਲੇ ਦਾ ਟਾਈਮਸਟੈਂਪ, ਮੈਨੇਜਰ ਪਛਾਣ, ਅਤੇ ਬੇਨਤੀ ਸਨੈਪਸ਼ਾਟ ਸੁਰੱਖਿਅਤ ਢੰਗ ਨਾਲ ਸਟੋਰ ਕੀਤੇ ਜਾਣਗੇ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registo da data e hora da decisão, a identidade do gestor e o instantâneo do pedido serão armazenados em segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметка времени принятия решения, идентификатор руководителя и снимок запроса будут надежно сохранены."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முடிவின் நேரமுத்திரை, மேலாளரின் அடையாளம் மற்றும் கோரிக்கையின் ஸ்னாப்ஷாட் ஆகியவை பாதுகாப்பாகச் சேமிக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నిర్ణయ టైమ్‌స్టాంప్, మేనేజర్ గుర్తింపు మరియు అభ్యర్థన స్నాప్‌షాట్ సురక్షితంగా నిల్వ చేయబడతాయి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "决策时间戳、经理身份和请求快照将被安全存储。"
