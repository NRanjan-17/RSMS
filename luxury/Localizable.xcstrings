    "After Sales Ticket submitted successfully." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إرسال طلب خدمة ما بعد البيع بنجاح."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিক্ৰীৰ পিছত টিকট সফলতাৰে জমা দিয়া হৈছে।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিক্রয়োত্তর টিকেট সফলভাবে জমা দেওয়া হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kundendienstticket erfolgreich übermittelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ticket de servicio posventa se ha enviado correctamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ticket après-vente soumis avec succès."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વેચાણ પછીની ટિકિટ સફળતાપૂર્વક સબમિટ થઈ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिक्री के बाद का टिकट सफलतापूर्वक जमा हो गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesta di assistenza post-vendita inviata con successo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アフターサービスチケットが正常に送信されました。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಾರಾಟದ ನಂತರದ ಟಿಕೆಟ್ ಯಶಸ್ವಿಯಾಗಿ ಸಲ್ಲಿಸಲಾಗಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애프터서비스 요청이 성공적으로 제출되었습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വിൽപ്പനാനന്തര ടിക്കറ്റ് വിജയകരമായി സമർപ്പിച്ചു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विक्रीनंतरचे तिकीट यशस्वीरित्या सादर झाले."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିକ୍ରୟ ପରେ ଟିକେଟ୍ ସଫଳତାର ସହ ଦାଖଲ ହୋଇଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵਿਕਰੀ ਤੋਂ ਬਾਅਦ ਟਿਕਟ ਸਫਲਤਾਪੂਰਵਕ ਜਮ੍ਹਾਂ ਹੋ ਗਈ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pedido de pós-venda foi enviado com sucesso."
          }
