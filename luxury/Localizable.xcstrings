    "You have unsaved changes. Are you sure you want to go back? Your changes will be lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك تغييرات غير محفوظة. هل أنت متأكد من رغبتك في الرجوع؟ ستفقد تغييراتك."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপোনাৰ অসংৰক্ষিত পৰিবৰ্তন আছে। আপুনি নিশ্চিত নেকি যে আপুনি উভতি যাব বিচাৰে? আপোনাৰ পৰিৱৰ্তনবোৰ হেৰাই যাব।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কিছু পরিবর্তন সংরক্ষিত হয়নি। আপনি কি আগের অবস্থায় ফিরে যেতে চান? আপনার পরিবর্তনগুলো হারিয়ে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben ungespeicherte Änderungen. Möchten Sie wirklich zurück? Ihre Änderungen gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes cambios sin guardar. ¿Seguro que quieres volver atrás? Perderás los cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez des modifications non enregistrées. Êtes-vous sûr de vouloir revenir en arrière ? Vos modifications seront perdues."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી પાસે વણસાચવેલા ફેરફારો છે. શું તમે ખરેખર પાછા જવા માંગો છો? તમારા ફેરફારો ગુમ થઈ જશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने कुछ बदलाव सेव नहीं किए हैं। क्या आप वाकई वापस जाना चाहते हैं? अगर आप वापस जाना चाहते हैं, तो आपके बदलाव नष्ट हो जाएंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai apportato delle modifiche non salvate. Sei sicuro di voler tornare indietro? Le modifiche andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されていない変更があります。本当に元に戻しますか？変更内容は失われます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಉಳಿಸದ ಬದಲಾವಣೆಗಳನ್ನು ಹೊಂದಿದ್ದೀರಿ. ನೀವು ಹಿಂತಿರುಗಲು ಖಚಿತವಾಗಿ ಬಯಸುವಿರಾ? ನಿಮ್ಮ ಬದಲಾವಣೆಗಳು ಕಳೆದುಹೋಗುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않은 변경 사항이 있습니다. 정말로 되돌리시겠습니까? 변경 내용이 손실됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾക്ക് സംരക്ഷിക്കാത്ത മാറ്റങ്ങളുണ്ട്. തിരികെ പോകണമെന്ന് ഉറപ്പാണോ? നിങ്ങളുടെ മാറ്റങ്ങൾ നഷ്ടപ്പെടും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही केलेले बदल जतन केलेले नाहीत. तुम्हाला खात्री आहे की तुम्हाला मागे जायचे आहे? तुमचे बदल गमावले जातील."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କର ପରିବର୍ତ୍ତନଗୁଡ଼ିକ ସେଭ୍ ହୋଇନାହିଁ। ଆପଣ କ’ଣ ନିଶ୍ଚିତ ଯେ ଆପଣ ଫେରିବାକୁ ଚାହୁଁଛନ୍ତି? ଆପଣଙ୍କର ପରିବର୍ତ୍ତନଗୁଡ଼ିକ ହରାଇବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ ਕੋਲ ਅਣਰੱਖਿਅਤ ਬਦਲਾਅ ਹਨ। ਕੀ ਤੁਸੀਂ ਯਕੀਨਨ ਵਾਪਸ ਜਾਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਤੁਹਾਡੇ ਬਦਲਾਅ ਗੁੰਮ ਹੋ ਜਾਣਗੇ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem alterações não guardadas. Tem a certeza de que pretende desfazer as alterações? Elas serão perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас есть несохраненные изменения. Вы уверены, что хотите вернуться назад? Ваши изменения будут потеряны."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் சேமிக்காத மாற்றங்கள் உள்ளன. நீங்கள் நிச்சயமாகப் பழைய நிலைக்குத் திரும்ப விரும்புகிறீர்களா? இல்லையெனில், உங்கள் மாற்றங்கள் இழக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు సేవ్ చేయని మార్పులు ఉన్నాయి. మీరు నిజంగా వెనక్కి వెళ్లాలనుకుంటున్నారా? మీ మార్పులు పోతాయి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您有未保存的更改。确定要返回吗？您的更改将会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您有未儲存的變更。確定要回嗎？您的變更將會遺失。"
          }
        }
      }
    },
