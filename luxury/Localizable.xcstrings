    "Expected and scanned quantities match." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكميات المتوقعة والممسوحة ضوئياً متطابقة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্ৰত্যাশিত আৰু স্কেন কৰা পৰিমাণ মিল খায়।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রত্যাশিত এবং স্ক্যান করা পরিমাণ মিলে গেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erwarteten und die gescannten Mengen stimmen überein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cantidades esperadas y las escaneadas coinciden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les quantités attendues et scannées correspondent."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અપેક્ષિત અને સ્કેન કરેલા જથ્થા મેળ ખાય છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपेक्षित और स्कैन की गई मात्राएँ मेल खाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le quantità previste e quelle rilevate corrispondono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想定数量とスキャン数量が一致しました。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿರೀಕ್ಷಿತ ಮತ್ತು ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಪ್ರಮಾಣಗಳು ಹೊಂದಿಕೆಯಾಗುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예상 수량과 측정된 수량이 일치합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രതീക്ഷിച്ചതും സ്കാൻ ചെയ്തതുമായ അളവുകൾ പൊരുത്തപ്പെടുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपेक्षित आणि स्कॅन केलेली संख्या जुळतात."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଶାକରାଯାଇଥିବା ଏବଂ ସ୍କାନ କରାଯାଇଥିବା ପରିମାଣ ମେଳ ଖାଉଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਮੀਦ ਕੀਤੀ ਗਈ ਅਤੇ ਸਕੈਨ ਕੀਤੀ ਮਾਤਰਾ ਮੇਲ ਖਾਂਦੀ ਹੈ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As quantidades esperadas e as quantidades verificadas coincidem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидаемое и отсканированное количество совпадают."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எதிர்பார்க்கப்பட்ட மற்றும் ஸ்கேன் செய்யப்பட்ட அளவுகள் பொருந்துகின்றன."
          }
        },
        "te" : {
