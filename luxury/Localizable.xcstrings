    "This will notify all invited clients about the cancellation and remove the trunk show from the boutique calendar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا سيبلغ جميع العملاء المدعوين بالإلغاء ويزيل العرض الرئيسي من تقويم البوتيك."
          }
        },
