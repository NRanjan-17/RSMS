          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു SMS സ്ഥിരീകരണ കോഡ് ഉപയോഗിച്ച് നിങ്ങളുടെ അക്കൗണ്ട് സുരക്ഷിതമാക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एसएमएस व्हेरिफिकेशन कोड वापरून आपले खाते सुरक्षित करा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏକ SMS ଯାଞ୍ଚକରଣ କୋଡ୍ ସହିତ ଆପଣଙ୍କ ଆକାଉଣ୍ଟକୁ ସୁରକ୍ଷିତ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੇ ਖਾਤੇ ਨੂੰ ਇੱਕ SMS ਪੁਸ਼ਟੀਕਰਨ ਕੋਡ ਨਾਲ ਸੁਰੱਖਿਅਤ ਕਰੋ।"
          }
        },
