          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പാരീസ് മാനേജരുടെ അംഗീകാരത്തിനായി കാത്തിരിക്കുന്ന ഒരു അഭ്യർത്ഥനയുമില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पॅरिस व्यवस्थापकाच्या मंजुरीची वाट पाहणारी कोणतीही नवीन विनंती नाही."
