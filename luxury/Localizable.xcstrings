          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ಥಳೀಯ ಮತ್ತು ಪ್ರಾದೇಶಿಕ ಅಂಗಡಿಗಳ ಲಭ್ಯತೆಯನ್ನು ಪರಿಶೀಲಿಸಲು ಐಟಂ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 상품을 선택하여 지역 및 인근 부티크의 재고 여부를 확인하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രാദേശിക, പ്രാദേശിക ബുട്ടീക്ക് ലഭ്യത പരിശോധിക്കാൻ ഒരു ഇനം തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थानिक आणि प्रादेशिक बुटीकमधील उपलब्धता तपासण्यासाठी वस्तू निवडा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସ୍ଥାନୀୟ ଏବଂ ଆଞ୍ଚଳିକ ବୁଟିକ୍ ଉପଲବ୍ଧତା ଯାଞ୍ଚ କରିବା ପାଇଁ ଏକ ଜିନିଷ ଚୟନ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਥਾਨਕ ਅਤੇ ਖੇਤਰੀ ਬੁਟੀਕ ਉਪਲਬਧਤਾ ਦੀ ਪੁਸ਼ਟੀ ਕਰਨ ਲਈ ਇੱਕ ਆਈਟਮ ਚੁਣੋ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um artigo para verificar a disponibilidade nas lojas locais e regionais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите товар, чтобы проверить его наличие в местных и региональных бутиках."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உள்ளூர் மற்றும் பிராந்திய கடைகளில் பொருள் கிடைக்குமா என்பதைச் சரிபார்க்க, ஒரு பொருளைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్థానిక మరియు ప్రాంతీయ బోటిక్‌లలో లభ్యతను ధృవీకరించడానికి ఒక వస్తువును ఎంచుకోండి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择商品以查看当地及周边精品店的库存情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇商品以查看當地及週邊精品店的庫存。"
          }
        }
      }
