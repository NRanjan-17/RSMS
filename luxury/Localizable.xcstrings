    "I agree to the internal policies, data privacy agreement, and terms of service required for system access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوافق على السياسات الداخلية واتفاقية خصوصية البيانات وشروط الخدمة المطلوبة للوصول إلى النظام."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মই চিস্টেম অভিগমৰ বাবে প্ৰয়োজনীয় আভ্যন্তৰীণ নীতি, তথ্য গোপনীয়তা চুক্তি, আৰু সেৱাৰ চৰ্তসমূহত সন্মত।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি সিস্টেম অ্যাক্সেসের জন্য প্রয়োজনীয় অভ্যন্তরীণ নীতিমালা, ডেটা গোপনীয়তা চুক্তি এবং পরিষেবার শর্তাবলীতে সম্মত আছি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich stimme den internen Richtlinien, der Datenschutzerklärung und den Nutzungsbedingungen für den Systemzugriff zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepto las políticas internas, el acuerdo de privacidad de datos y los términos de servicio necesarios para acceder al sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'accepte les politiques internes, l'accord de confidentialité des données et les conditions d'utilisation requis pour l'accès au système."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હું સિસ્ટમ ઍક્સેસ માટે જરૂરી આંતરિક નીતિઓ, ડેટા ગોપનીયતા કરાર અને સેવાની શરતો સાથે સંમત છું."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं सिस्टम तक पहुंच के लिए आवश्यक आंतरिक नीतियों, डेटा गोपनीयता समझौते और सेवा की शर्तों से सहमत हूं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetto le politiche interne, l'accordo sulla privacy dei dati e i termini di servizio necessari per l'accesso al sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は、システムへのアクセスに必要な内部ポリシー、データプライバシーに関する合意事項、および利用規約に同意します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಿಸ್ಟಮ್ ಪ್ರವೇಶಕ್ಕೆ ಅಗತ್ಯವಿರುವ ಆಂತರಿಕ ನೀತಿಗಳು, ಡೇಟಾ ಗೌಪ್ಯತಾ ಒಪ್ಪಂದ ಮತ್ತು ಸೇವಾ ನಿಯಮಗಳನ್ನು ನಾನು ಒಪ್ಪುತ್ತೇನೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인은 시스템 접근에 필요한 내부 정책, 데이터 개인정보 보호 계약 및 서비스 약관에 동의합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സിസ്റ്റം ആക്‌സസിന് ആവശ്യമായ ആന്തരിക നയങ്ങൾ, ഡാറ്റ സ്വകാര്യതാ കരാർ, സേവന നിബന്ധനകൾ എന്നിവ ഞാൻ അംഗീകരിക്കുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मी सिस्टम ॲक्सेससाठी आवश्यक असलेल्या अंतर्गत धोरणे, डेटा गोपनीयता करार आणि सेवा अटींना सहमत आहे."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୁଁ ସିଷ୍ଟମ ପ୍ରବେଶ ପାଇଁ ଆବଶ୍ୟକ ଆଭ୍ୟନ୍ତରୀଣ ନୀତି, ଡାଟା ଗୋପନୀୟତା ଚୁକ୍ତିନାମା ଏବଂ ସେବାର ସର୍ତ୍ତାବଳୀ ସହିତ ରାଜି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੈਂ ਸਿਸਟਮ ਪਹੁੰਚ ਲਈ ਲੋੜੀਂਦੀਆਂ ਅੰਦਰੂਨੀ ਨੀਤੀਆਂ, ਡੇਟਾ ਗੋਪਨੀਯਤਾ ਸਮਝੌਤੇ ਅਤੇ ਸੇਵਾ ਦੀਆਂ ਸ਼ਰਤਾਂ ਨਾਲ ਸਹਿਮਤ ਹਾਂ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concordo com as políticas internas, o acordo de privacidade de dados e os termos de serviço necessários para o acesso ao sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я согласен с внутренними правилами, соглашением о конфиденциальности данных и условиями предоставления услуг, необходимыми для доступа к системе."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கணினி அமைப்பை அணுகுவதற்குத் தேவையான உள்ளகக் கொள்கைகள், தரவு தனியுரிமை ஒப்பந்தம் மற்றும் சேவை விதிமுறைகளை நான் ஏற்றுக்கொள்கிறேன்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సిస్టమ్ యాక్సెస్ కోసం అవసరమైన అంతర్గత విధానాలు, డేటా గోప్యతా ఒప్పందం మరియు సేవా నిబంధనలకు నేను అంగీకరిస్తున్నాను."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我同意系统访问所需的内部政策、数据隐私协议和服务条款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我同意系統存取所需的內部政策、資料隱私協議和服務條款。"
          }
        }
      }
    },
