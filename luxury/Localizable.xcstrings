    "Secure your account with an SMS verification code." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتأمين حسابك باستخدام رمز التحقق عبر الرسائل النصية القصيرة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটা এছএমএছ সত্যাপন ক'ডৰ সৈতে আপোনাৰ একাউণ্ট সুৰক্ষিত কৰক।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এসএমএস ভেরিফিকেশন কোডের মাধ্যমে আপনার অ্যাকাউন্ট সুরক্ষিত করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern Sie Ihr Konto mit einem SMS-Bestätigungscode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege tu cuenta con un código de verificación por SMS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sécurisez votre compte avec un code de vérification par SMS."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા એકાઉન્ટને SMS વેરિફિકેશન કોડ વડે સુરક્ષિત કરો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एसएमएस सत्यापन कोड से अपना खाता सुरक्षित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteggi il tuo account con un codice di verifica via SMS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS認証コードでアカウントを保護してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS ಪರಿಶೀಲನಾ ಕೋಡ್‌ನೊಂದಿಗೆ ನಿಮ್ಮ ಖಾತೆಯನ್ನು ಸುರಕ್ಷಿತಗೊಳಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
