        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ಯೂನಿಟ್‌ಗಳನ್ನು ಲಭ್ಯವಿರುವ ಸ್ಟಾಕ್‌ಗೆ ಹಿಂತಿರುಗಿಸಿ"
