          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld യൂണിറ്റുകൾ ലഭ്യമായ സ്റ്റോക്കിലേക്ക് തിരികെ വിടുക"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld युनिट्स पुन्हा उपलब्ध स्टॉकमध्ये सोडा"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ୟୁନିଟଗୁଡ଼ିକୁ ଉପଲବ୍ଧ ଷ୍ଟକରେ ଫେରାଇ ଆଣନ୍ତୁ"
