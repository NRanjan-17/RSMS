    "Open stock reconciliation to scan barcodes or QR codes, compare expected versus scanned quantities, and submit inventory corrections." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح عملية مطابقة المخزون لمسح الرموز الشريطية أو رموز الاستجابة السريعة، وقارن الكميات المتوقعة بالكميات الممسوحة ضوئيًا، وأرسل تصحيحات المخزون."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাৰক'ড বা QR ক'ড স্কেন কৰিবলৈ, প্ৰত্যাশিত বনাম স্কেন কৰা পৰিমাণ তুলনা কৰিবলৈ, আৰু তথ্য সংশোধন জমা দিবলৈ মুকলি ষ্টক মিলন।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বারকোড বা কিউআর কোড স্ক্যান করতে, প্রত্যাশিত ও স্ক্যান করা পরিমাণের তুলনা করতে এবং ইনভেন্টরি সংশোধন জমা দিতে স্টক সমন্বয় প্রক্রিয়াটি চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie den Bestandsabgleich, um Barcodes oder QR-Codes zu scannen, die erwarteten Mengen mit den gescannten Mengen zu vergleichen und Bestandskorrekturen einzureichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra la conciliación de existencias para escanear códigos de barras o códigos QR, compare las cantidades esperadas con las escaneadas y envíe las correcciones de inventario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effectuer le rapprochement des stocks ouverts en scannant les codes-barres ou les codes QR, en comparant les quantités attendues aux quantités scannées et en soumettant les corrections d'inventaire."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બારકોડ અથવા QR કોડ સ્કેન કરવા માટે સ્ટોક રિકન્સિલિયેશન ખોલો, અપેક્ષિત વિરુદ્ધ સ્કેન કરેલા જથ્થાની તુલના કરો અને ઇન્વેન્ટરી સુધારા સબમિટ કરો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारकोड या क्यूआर कोड को स्कैन करने, अपेक्षित मात्राओं की स्कैन की गई मात्राओं से तुलना करने और इन्वेंट्री संबंधी सुधार प्रस्तुत करने के लिए ओपन स्टॉक रिकॉन्सिलिएशन की सुविधा उपलब्ध है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprire la riconciliazione delle scorte per scansionare codici a barre o codici QR, confrontare le quantità previste con quelle scansionate e inviare le correzioni di inventario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在庫照合を開始するには、バーコードまたはQRコードをスキャンし、想定数量とスキャンされた数量を比較して、在庫修正を提出します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬಾರ್‌ಕೋಡ್‌ಗಳು ಅಥವಾ QR ಕೋಡ್‌ಗಳನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಲು, ನಿರೀಕ್ಷಿತ ಮತ್ತು ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಪ್ರಮಾಣಗಳನ್ನು ಹೋಲಿಸಲು ಮತ್ತು ದಾಸ್ತಾನು ತಿದ್ದುಪಡಿಗಳನ್ನು ಸಲ್ಲಿಸಲು ಸ್ಟಾಕ್ ಸಮನ್ವಯವನ್ನು ತೆರೆಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바코드 또는 QR 코드를 스캔하여 재고를 대조하고, 예상 수량과 스캔된 수량을 비교하여 재고 오류를 수정할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ബാർകോഡുകളോ ക്യുആർ കോഡുകളോ സ്കാൻ ചെയ്യുന്നതിനും, പ്രതീക്ഷിക്കുന്നതും സ്കാൻ ചെയ്തതുമായ അളവുകൾ താരതമ്യം ചെയ്യുന്നതിനും, ഇൻവെന്ററി തിരുത്തലുകൾ സമർപ്പിക്കുന്നതിനും സ്റ്റോക്ക് അനുരഞ്ജനം തുറക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारकोड किंवा क्यूआर कोड स्कॅन करण्यासाठी, अपेक्षित आणि स्कॅन केलेल्या प्रमाणांची तुलना करण्यासाठी, आणि इन्व्हेंटरी दुरुस्त्या सादर करण्यासाठी ओपन स्टॉक रिकन्सिलिएशन करा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବାରକୋଡ୍ କିମ୍ବା QR କୋଡ୍ ସ୍କାନ୍ କରିବା ପାଇଁ ଷ୍ଟକ୍ ପୁନଃସମାପନ ଖୋଲନ୍ତୁ, ଆଶାକରାଯାଇଥିବା ପରିମାଣ ବନାମ ସ୍କାନ ପରିମାଣ ତୁଳନା କରନ୍ତୁ, ଏବଂ ଇନଭେଣ୍ଟରୀ ସଂଶୋଧନ ଦାଖଲ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਾਰਕੋਡ ਜਾਂ QR ਕੋਡ ਸਕੈਨ ਕਰਨ ਲਈ ਸਟਾਕ ਮੇਲ-ਮਿਲਾਪ ਖੋਲ੍ਹੋ, ਉਮੀਦ ਕੀਤੀ ਬਨਾਮ ਸਕੈਨ ਕੀਤੀ ਮਾਤਰਾ ਦੀ ਤੁਲਨਾ ਕਰੋ, ਅਤੇ ਵਸਤੂ ਸੂਚੀ ਵਿੱਚ ਸੁਧਾਰ ਜਮ੍ਹਾਂ ਕਰੋ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conciliação de stock aberto para digitalizar códigos de barras ou códigos QR, comparar as quantidades esperadas com as digitalizadas e enviar correções de inventário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте окно сверки запасов, чтобы отсканировать штрихкоды или QR-коды, сравнить ожидаемое и отсканированное количество и отправить корректировки инвентаризации."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பார்கோடுகள் அல்லது கியூஆர் குறியீடுகளை ஸ்கேன் செய்யவும், எதிர்பார்க்கப்பட்ட அளவுகளை ஸ்கேன் செய்யப்பட்ட அளவுகளுடன் ஒப்பிடவும், மற்றும் சரக்கு இருப்புத் திருத்தங்களைச் சமர்ப்பிக்கவும் இருப்புச் சரிபார்ப்புப் பணியைத் தொடங்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బార్‌కోడ్‌లు లేదా క్యూఆర్ కోడ్‌లను స్కాన్ చేయడానికి, ఆశించిన మరియు స్కాన్ చేసిన పరిమాణాలను పోల్చడానికి, మరియు ఇన్వెంటరీ సవరణలను సమర్పించడానికి ఓపెన్ స్టాక్ రికన్సిలియేషన్‌ను ఉపయోగించండి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开库存核对表，扫描条形码或二维码，比较预期数量与扫描数量，并提交库存更正。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟庫存核對錶，掃描條碼或二維碼，比較預期數量與掃描數量，並提交庫存更正。"
          }
        }
      }
    },
