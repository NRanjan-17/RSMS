    "Align barcode within the frame to scan.\nIt will be added to the cart automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بمحاذاة الرمز الشريطي داخل الإطار لمسحه ضوئيًا.\nسيتم إضافته إلى سلة التسوق تلقائيًا."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্কেন কৰিবলৈ ফ্ৰেমৰ ভিতৰত বাৰক'ড প্ৰান্তিককৰণ কৰক।\nইয়াক স্বয়ংক্ৰিয়ভাৱে কাৰ্টত যোগ কৰা হ'ব।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্যান করার জন্য বারকোডটি ফ্রেমের মধ্যে রাখুন।\nএটি স্বয়ংক্রিয়ভাবে কার্টে যুক্ত হয়ে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richten Sie den Barcode zum Scannen im Rahmen aus.\nEr wird automatisch dem Warenkorb hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinea el código de barras dentro del marco para escanearlo.\nSe añadirá al carrito automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alignez le code-barres dans le cadre pour le scanner.\nIl sera automatiquement ajouté au panier."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સ્કેન કરવા માટે બારકોડને ફ્રેમમાં ગોઠવો.\nતે આપમેળે કાર્ટમાં ઉમેરવામાં આવશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन करने के लिए बारकोड को फ्रेम के अंदर रखें।\nयह स्वचालित रूप से कार्ट में जुड़ जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allineare il codice a barre all'interno della cornice per la scansione.\nVerrà aggiunto automaticamente al carrello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンするには、バーコードをフレーム内に合わせます。\n自動的にカートに追加されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ಫ್ರೇಮ್‌ನೊಳಗೆ ಬಾರ್‌ಕೋಡ್ ಅನ್ನು ಜೋಡಿಸಿ.\nಇದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕಾರ್ಟ್‌ಗೆ ಸೇರಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바코드를 스캔할 프레임 안에 맞춰주세요.\n자동으로 장바구니에 추가됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്കാൻ ചെയ്യുന്നതിനായി ഫ്രെയിമിനുള്ളിൽ ബാർകോഡ് വിന്യസിക്കുക.\nഇത് യാന്ത്രികമായി കാർട്ടിലേക്ക് ചേർക്കപ്പെടും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कॅन करण्यासाठी बारकोड फ्रेमच्या आत जुळवा.\nते आपोआप कार्टमध्ये जोडले जाईल."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସ୍କାନ କରିବା ପାଇଁ ଫ୍ରେମ୍ ମଧ୍ୟରେ ବାରକୋଡ୍ ସଜାନ୍ତୁ।\nଏହା ସ୍ୱୟଂଚାଳିତ ଭାବରେ କାର୍ଟରେ ଯୋଡାଯିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਕੈਨ ਕਰਨ ਲਈ ਬਾਰਕੋਡ ਨੂੰ ਫਰੇਮ ਦੇ ਅੰਦਰ ਇਕਸਾਰ ਕਰੋ।\nਇਹ ਆਪਣੇ ਆਪ ਕਾਰਟ ਵਿੱਚ ਜੋੜਿਆ ਜਾਵੇਗਾ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinhe o código de barras dentro da moldura para digitalizar.\nSerá adicionado ao carrinho automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выровняйте штрихкод внутри рамки для сканирования.\nОн будет автоматически добавлен в корзину."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஸ்கேன் செய்வதற்கு பார்கோடை சட்டகத்திற்குள் சீரமைக்கவும்.\nஅது தானாகவே கூடையில் சேர்க்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్కాన్ చేయడానికి బార్‌కోడ్‌ను ఫ్రేమ్‌లో అమర్చండి.\nఇది ఆటోమేటిక్‌గా కార్ట్‌కు జోడించబడుతుంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将条形码对准扫描框进行扫描。\n商品将自动添加到购物车。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
