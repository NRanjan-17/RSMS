        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଗଣନା ଦାଖଲ କରାଯାଇଛି। ଇନଭେଣ୍ଟୋରୀ ରେକର୍ଡ ସଫଳତାର ସହ ଅପଡେଟ୍ ହୋଇଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਗਿਣਤੀ ਜਮ੍ਹਾਂ ਹੋ ਗਈ। ਵਸਤੂ ਸੂਚੀ ਦਾ ਰਿਕਾਰਡ ਸਫਲਤਾਪੂਰਵਕ ਅੱਪਡੇਟ ਕੀਤਾ ਗਿਆ।"
