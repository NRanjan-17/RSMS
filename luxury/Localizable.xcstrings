    "Scan barcodes or QR codes to resolve quantity mismatches" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرموز الشريطية أو رموز الاستجابة السريعة لحل مشكلة عدم تطابق الكميات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৰিমাণৰ মিল নোহোৱা সমাধান কৰিবলৈ বাৰক'ড বা QR ক'ড স্কেন কৰক"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিমাণের অমিল সমাধান করতে বারকোড বা কিউআর কোড স্ক্যান করুন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen Sie Barcodes oder QR-Codes, um Mengenabweichungen zu beheben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanee códigos de barras o códigos QR para resolver discrepancias en las cantidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez les codes-barres ou les codes QR pour résoudre les problèmes de quantités."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જથ્થામાં મેળ ન ખાતી સમસ્યાને ઉકેલવા માટે બારકોડ અથવા QR કોડ સ્કેન કરો"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मात्रा में विसंगतियों को दूर करने के लिए बारकोड या क्यूआर कोड स्कैन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona i codici a barre o i codici QR per risolvere le discrepanze di quantità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数量の不一致を解消するには、バーコードまたはQRコードをスキャンしてください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರಮಾಣ ಹೊಂದಾಣಿಕೆಯ ಸಮಸ್ಯೆಗಳನ್ನು ಪರಿಹರಿಸಲು ಬಾರ್‌ಕೋಡ್‌ಗಳು ಅಥವಾ QR ಕೋಡ್‌ಗಳನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수량 불일치를 해결하려면 바코드 또는 QR 코드를 스캔하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അളവിലെ പൊരുത്തക്കേടുകൾ പരിഹരിക്കാൻ ബാർകോഡുകളോ QR കോഡുകളോ സ്കാൻ ചെയ്യുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रमाणातील तफावत दूर करण्यासाठी बारकोड किंवा क्यूआर कोड स्कॅन करा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପରିମାଣ ମେଳ ନହେବା ସମାଧାନ ପାଇଁ ବାରକୋଡ୍ କିମ୍ବା QR କୋଡ୍ ସ୍କାନ୍ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮਾਤਰਾ ਦੇ ਮੇਲ ਨਾ ਖਾਣ ਨੂੰ ਹੱਲ ਕਰਨ ਲਈ ਬਾਰਕੋਡ ਜਾਂ QR ਕੋਡ ਸਕੈਨ ਕਰੋ"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitalize códigos de barras ou códigos QR para resolver discrepâncias de quantidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканируйте штрихкоды или QR-коды для устранения несоответствий в количестве."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அளவுப் பொருத்தமின்மைகளைச் சரிசெய்ய பார்கோடுகள் அல்லது QR குறியீடுகளை ஸ்கேன் செய்யவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పరిమాణ వ్యత్యాసాలను పరిష్కరించడానికి బార్‌కోడ్‌లు లేదా QR కోడ్‌లను స్కాన్ చేయండి"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描条形码或二维码以解决数量不符问题"
          }
        },
        "zh-Hant" : {
