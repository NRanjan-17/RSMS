    "Decision timestamp, manager identity, and request snapshot will be securely stored." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تخزين طابع القرار الزمني وهوية المدير وصورة الطلب بشكل آمن."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decision timestamp, manager identity, and request snapshot will be securely stored."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিদ্ধান্তের টাইমস্ট্যাম্প, পরিচালকের পরিচয় এবং অনুরোধ স্ন্যাপশট নিরাপদে সংরক্ষণ করা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decision timestamp, manager identity, and request snapshot will be securely stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decision timestamp, manager identity, and request snapshot will be securely stored."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’horodatage de décision, l’identité du manager et l’instantané de la requête seront stockés de manière sécurisée."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નિર્ણય ટાઇમસ્ટેમ્પ, વ્યવસ્થાપક ઓળખ અને વિનંતી સ્નેપશોટ સુરક્ષિત રીતે સંગ્રહિત કરવામાં આવશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्णय टाइमस्टैम्प, प्रबंधक पहचान और अनुरोध स्नैपशॉट सुरक्षित रूप से संग्रहीत किया जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il timestamp della decisione, l'identità del manager e lo snapshot della richiesta saranno memorizzati in modo sicuro."
          }
        },
        "ja" : {
