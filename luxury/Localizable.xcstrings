    "Mismatch detected. Submit the scanned quantity to correct inventory." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اكتشاف عدم تطابق. قدم الكمية الممسوحة ضوئيا إلى المخزون الصحيح."
