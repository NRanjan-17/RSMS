        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수량 제출 완료. 재고 기록이 성공적으로 업데이트되었습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എണ്ണം സമർപ്പിച്ചു. ഇൻവെന്ററി റെക്കോർഡ് വിജയകരമായി അപ്ഡേറ്റ് ചെയ്തു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मोजणी सादर केली. मालसाठा नोंद यशस्वीरित्या अद्ययावत झाली."
