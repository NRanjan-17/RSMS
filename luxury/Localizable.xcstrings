    "Open stock reconciliation to scan barcodes or QR codes, compare expected versus scanned quantities, and submit inventory corrections." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح مطابقة المخزون مع رموز الباركود أو رموز QR، وقارن الكميات المتوقعة مقابل الكميات الممسوحة، وقدم تصحيحات للمخزون."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open stock reconciliation to scan barcodes or QR codes, compare expected versus scanned quantities, and submit inventory corrections."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বারকোড বা কিউআর কোডগুলি স্ক্যান করতে, প্রত্যাশিত বনাম স্ক্যান করা পরিমাণের তুলনা করতে এবং ইনভেন্টরি সংশোধন জমা দিতে স্টক পুনর্মিলন খুলুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open stock reconciliation to scan barcodes or QR codes, compare expected versus scanned quantities, and submit inventory corrections."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open stock reconciliation to scan barcodes or QR codes, compare expected versus scanned quantities, and submit inventory corrections."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouverture du rapprochement des stocks pour scanner des codes-barres ou des QR codes, comparer les quantités attendues et numérisées, et soumettre des corrections d’inventaire."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બારકોડ અથવા ક્યૂઆર કોડ્સ સ્કેન કરવા માટે સ્ટોક સમાધાન ખોલો, અપેક્ષિત વિરુદ્ધ સ્કેન કરેલા જથ્થાની તુલના કરો અને માલ સુચિ સુધારણા સબમિટ કરો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारकोड या क्यूआर कोड को स्कैन करने, अपेक्षित बनाम स्कैन की गई मात्रा की तुलना करने और इन्वेंट्री सुधार सबमिट करने के लिए स्टॉक सुलह खोलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri la riconciliazione delle scorte per scansionare codici a barre o codici QR, confronta le quantità attese e quelle scansionate e invia correzioni di inventario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open stock reconciliation to scan barcodes or QR codes, compare expected versus scanned quantities, and submit inventory corrections."
          }
        },
