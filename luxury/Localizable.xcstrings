    "Duplicate catalog detected! A catalog with this barcode already exists." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اكتشاف كتالوج مكرر! يوجد بالفعل كتالوج يحمل هذا الرمز الشريطي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডুপ্লিকেট কেটেলগ ধৰা পৰিল! এই বাৰক'ডৰ সৈতে এটা কেটেলগ ইতিমধ্যে আছে।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সদৃশ ক্যাটালগ শনাক্ত করা হয়েছে! এই বারকোডসহ একটি ক্যাটালগ ইতিমধ্যেই বিদ্যমান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelter Katalog erkannt! Ein Katalog mit diesem Barcode existiert bereits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Catálogo duplicado detectado! Ya existe un catálogo con este código de barras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catalogue en double détecté ! Un catalogue portant ce code-barres existe déjà."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ડુપ્લિકેટ કેટલોગ મળ્યો! આ બારકોડ ધરાવતો કેટલોગ પહેલેથી જ અસ્તિત્વમાં છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डुप्लिकेट कैटलॉग का पता चला! इस बारकोड वाला कैटलॉग पहले से मौजूद है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevato catalogo duplicato! Esiste già un catalogo con questo codice a barre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複カタログが検出されました！このバーコードを持つカタログは既に存在します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಕಲಿ ಕ್ಯಾಟಲಾಗ್ ಪತ್ತೆಯಾಗಿದೆ! ಈ ಬಾರ್‌ಕೋಡ್ ಹೊಂದಿರುವ ಕ್ಯಾಟಲಾಗ್ ಈಗಾಗಲೇ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중복된 카탈로그가 감지되었습니다! 동일한 바코드를 가진 카탈로그가 이미 존재합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഡ്യൂപ്ലിക്കേറ്റ് കാറ്റലോഗ് കണ്ടെത്തി! ഈ ബാർകോഡ് ഉള്ള ഒരു കാറ്റലോഗ് ഇതിനകം നിലവിലുണ്ട്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डुप्लिकेट कॅटलॉग आढळला! या बारकोडचा कॅटलॉग आधीच अस्तित्वात आहे."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଡୁପ୍ଲିକେଟ୍ କ୍ୟାଟାଲଗ୍ ଚିହ୍ନଟ ହୋଇଛି! ଏହି ବାରକୋଡ୍ ସହିତ ଏକ କ୍ୟାଟାଲଗ୍ ପୂର୍ବରୁ ଅଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਡੁਪਲੀਕੇਟ ਕੈਟਾਲਾਗ ਮਿਲਿਆ! ਇਸ ਬਾਰਕੋਡ ਵਾਲਾ ਇੱਕ ਕੈਟਾਲਾਗ ਪਹਿਲਾਂ ਹੀ ਮੌਜੂਦ ਹੈ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catálogo duplicado detectado! Já existe um catálogo com este código de barras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обнаружен дубликат каталога! Каталог с таким штрихкодом уже существует."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நகல் பட்டியல் கண்டறியப்பட்டது! இந்த பார்கோடுடன் ஒரு பட்டியல் ஏற்கனவே உள்ளது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నకిలీ కేటలాగ్ కనుగొనబడింది! ఈ బార్‌కోడ్‌తో కూడిన కేటలాగ్ ఇప్పటికే ఉంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到重复目录！已存在具有此条形码的目录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測到重複目錄！已存在具有此條碼的目錄。"
          }
        }
      }
    },
