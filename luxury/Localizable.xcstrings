    "This will notify all invited clients about the cancellation and remove the trunk show from the boutique calendar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إخطار جميع العملاء المدعوين بشأن الإلغاء وإزالة عرض الأزياء من جدول أعمال المتجر."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইয়াৰ দ্বাৰা সকলো আমন্ত্ৰিত ক্লায়েণ্টক বাতিলৰ বিষয়ে অৱগত কৰা হ’ব আৰু বুটিক কেলেণ্ডাৰৰ পৰা ট্ৰাংক শ্ব’ আঁতৰোৱা হ’ব।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর মাধ্যমে আমন্ত্রিত সকল গ্রাহককে বাতিলকরণের বিষয়ে অবহিত করা হবে এবং বুটিকের ক্যালেন্ডার থেকে ট্রাঙ্ক শো-টি সরিয়ে ফেলা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle eingeladenen Kunden über die Absage informiert und die Trunk Show aus dem Boutique-Kalender entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto notificará a todos los clientes invitados sobre la cancelación y eliminará el evento del calendario de la boutique."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela permettra d'informer tous les clients invités de l'annulation et de retirer la présentation de la collection du calendrier de la boutique."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આનાથી બધા આમંત્રિત ગ્રાહકોને રદ કરવાની સૂચના મળશે અને બુટિક કેલેન્ડરમાંથી ટ્રંક શો દૂર થશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे सभी आमंत्रित ग्राहकों को रद्द होने की सूचना मिल जाएगी और बुटीक कैलेंडर से ट्रंक शो हटा दिया जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo avviserà tutti i clienti invitati dell'annullamento e rimuoverà la presentazione della collezione dal calendario della boutique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、招待されたすべてのお客様にキャンセルの旨が通知され、ブティックのカレンダーからトランクショーが削除されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ಎಲ್ಲಾ ಆಹ್ವಾನಿತ ಕ್ಲೈಂಟ್‌ಗಳಿಗೆ ರದ್ದತಿಯ ಬಗ್ಗೆ ತಿಳಿಸುತ್ತದೆ ಮತ್ತು ಬೂಟೀಕ್ ಕ್ಯಾಲೆಂಡರ್‌ನಿಂದ ಟ್ರಂಕ್ ಶೋ ಅನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 하면 초대받은 모든 고객에게 취소 사실이 통보되고 부티크 일정에서 트렁크 쇼가 삭제됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
