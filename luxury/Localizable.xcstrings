    "Corporate admin registration is not available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التسجيل الإداري للشركات غير متاح."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কৰ্পৰেট এডমিন পঞ্জীয়ন উপলব্ধ নহয়।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কর্পোরেট অ্যাডমিন নিবন্ধন উপলব্ধ নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Registrierung für Unternehmensadministratoren ist nicht möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de administración corporativa no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'inscription en tant qu'administrateur d'entreprise n'est pas disponible."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોર્પોરેટ એડમિન નોંધણી ઉપલબ્ધ નથી."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉर्पोरेट एडमिन पंजीकरण उपलब्ध नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione come amministratore aziendale non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法人管理者登録はご利用いただけません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕಾರ್ಪೊರೇಟ್ ನಿರ್ವಾಹಕ ನೋಂದಣಿ ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "법인 관리자 등록은 불가능합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കോർപ്പറേറ്റ് അഡ്മിൻ രജിസ്ട്രേഷൻ ലഭ്യമല്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉर्पोरेट प्रशासक नोंदणी उपलब्ध नाही."
          }
        },
        "or" : {
