    "The After Sales Ticket has been successfully generated and synced." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إنشاء تذكرة ما بعد البيع ومزامنتها بنجاح."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিক্ৰীৰ আফটাৰ টিকট সফলতাৰে সৃষ্টি আৰু ছিংক কৰা হৈছে।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিক্রয়োত্তর টিকেটটি সফলভাবে তৈরি এবং সিঙ্ক করা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das After-Sales-Ticket wurde erfolgreich generiert und synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ticket de servicio posventa se ha generado y sincronizado correctamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ticket après-vente a été généré et synchronisé avec succès."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વેચાણ પછીની ટિકિટ સફળતાપૂર્વક જનરેટ અને સિંક થઈ ગઈ છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिक्री के बाद की सेवा का टिकट सफलतापूर्वक जनरेट और सिंक हो गया है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ticket di assistenza post-vendita è stato generato e sincronizzato correttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アフターサービスチケットが正常に生成され、同期されました。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಾರಾಟದ ನಂತರದ ಟಿಕೆಟ್ ಅನ್ನು ಯಶಸ್ವಿಯಾಗಿ ರಚಿಸಲಾಗಿದೆ ಮತ್ತು ಸಿಂಕ್ ಮಾಡಲಾಗಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애프터서비스 티켓이 성공적으로 생성되어 동기화되었습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വിൽപ്പനാനന്തര ടിക്കറ്റ് വിജയകരമായി സൃഷ്ടിക്കുകയും സമന്വയിപ്പിക്കുകയും ചെയ്തു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विक्रीपश्चात तिकीट यशस्वीरित्या तयार आणि सिंक करण्यात आले आहे."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିକ୍ରୟ ପରବର୍ତ୍ତୀ ଟିକେଟ୍ ସଫଳତାର ସହ ସୃଷ୍ଟି ଏବଂ ସିଙ୍କ୍ରୋନାଇଜ୍ ହୋଇଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵਿਕਰੀ ਤੋਂ ਬਾਅਦ ਦੀ ਟਿਕਟ ਸਫਲਤਾਪੂਰਵਕ ਤਿਆਰ ਅਤੇ ਸਿੰਕ ਕੀਤੀ ਗਈ ਹੈ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ticket de pós-venda foi gerado e sincronizado com sucesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заказ на послепродажное обслуживание успешно сгенерирован и синхронизирован."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விற்பனைக்குப் பிந்தைய புகார் வெற்றிகரமாக உருவாக்கப்பட்டு ஒத்திசைக்கப்பட்டுள்ளது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అమ్మకాల తర్వాత టిక్కెట్ విజయవంతంగా రూపొందించబడింది మరియు సమకాలీకరించబడింది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "售后工单已成功生成并同步。"
          }
        },
        "zh-Hant" : {
