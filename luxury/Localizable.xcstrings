        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପ୍ୟାରିସ୍ ପରିଚାଳକଙ୍କ ଅନୁମତି ପାଇଁ କୌଣସି ଆଗମନ ଅନୁରୋଧ ଅପେକ୍ଷା କରିନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪੈਰਿਸ ਮੈਨੇਜਰ ਦੇ ਅਧਿਕਾਰ ਦੀ ਉਡੀਕ ਵਿੱਚ ਕੋਈ ਆਉਣ ਵਾਲੀਆਂ ਬੇਨਤੀਆਂ ਨਹੀਂ ਹਨ।"
          }
        },
