    "Client receives curated products, split tender estimate, and secure payment handoff placeholder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتلقى العميل منتجات مختارة بعناية، وتقديرًا مجزأً للعطاء، ومكانًا آمنًا لتسليم الدفع."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্লায়েণ্টে কিউৰেট কৰা সামগ্ৰী, বিভক্ত নিবিদা অনুমান, আৰু সুৰক্ষিত পেমেণ্ট হেণ্ডঅফ প্লেচহোল্ডাৰ লাভ কৰে।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্লায়েন্ট নির্বাচিত পণ্য, বিভক্ত টেন্ডার প্রাক্কলন এবং নিরাপদ অর্থপ্রদান হস্তান্তরের প্লেসহোল্ডার গ্রহণ করেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kunde erhält eine zusammengestellte Produktauswahl, eine aufgeteilte Angebotskalkulation und einen sicheren Zahlungsübergabe-Platzhalter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cliente recibe productos seleccionados, un presupuesto de licitación dividido y un marcador de posición para la transferencia segura del pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le client reçoit une sélection de produits, un devis fractionné et un espace réservé pour le transfert de paiement sécurisé."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ક્લાયન્ટને ક્યુરેટેડ પ્રોડક્ટ્સ, સ્પ્લિટ ટેન્ડર અંદાજ અને સુરક્ષિત ચુકવણી હેન્ડઓફ પ્લેસહોલ્ડર મળે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्राहक को चयनित उत्पाद, विभाजित निविदा अनुमान और सुरक्षित भुगतान हस्तांतरण के लिए एक स्थान उपलब्ध कराया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cliente riceve prodotti selezionati, un preventivo dettagliato e un segnaposto sicuro per il pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クライアントは、厳選された商品、分割入札の見積もり、および安全な支払い引き渡しのためのプレースホルダーを受け取ります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಗ್ರಾಹಕರು ಕ್ಯುರೇಟೆಡ್ ಉತ್ಪನ್ನಗಳು, ವಿಭಜಿತ ಟೆಂಡರ್ ಅಂದಾಜು ಮತ್ತು ಸುರಕ್ಷಿತ ಪಾವತಿ ಹ್ಯಾಂಡ್‌ಆಫ್ ಪ್ಲೇಸ್‌ಹೋಲ್ಡರ್ ಅನ್ನು ಪಡೆಯುತ್ತಾರೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고객은 엄선된 제품, 분할 견적 및 안전한 결제 전달을 위한 안내 메시지를 받습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ക്ലയന്റിന് ക്യൂറേറ്റഡ് ഉൽപ്പന്നങ്ങൾ, സ്പ്ലിറ്റ് ടെൻഡർ എസ്റ്റിമേറ്റ്, സുരക്ഷിത പേയ്‌മെന്റ് ഹാൻഡ്ഓഫ് പ്ലെയ്‌സ്‌ഹോൾഡർ എന്നിവ ലഭിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्राहकाला निवडक उत्पादने, विभाजित निविदा अंदाजपत्रक आणि सुरक्षित पेमेंट हस्तांतरण प्लेसहोल्डर मिळतात."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କ୍ଲାଏଣ୍ଟ କ୍ୟୁରେଟେଡ୍ ଉତ୍ପାଦ, ସ୍ପ୍ଲିଟ୍ ଟେଣ୍ଡର ଆକଳନ ଏବଂ ସୁରକ୍ଷିତ ପେମେଣ୍ଟ ହ୍ୟାଣ୍ଡଅଫ୍ ପ୍ଲେସହୋଲ୍ଡର୍ ପାଆନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕਲਾਇੰਟ ਨੂੰ ਕਿਉਰੇਟ ਕੀਤੇ ਉਤਪਾਦ, ਸਪਲਿਟ ਟੈਂਡਰ ਅਨੁਮਾਨ, ਅਤੇ ਸੁਰੱਖਿਅਤ ਭੁਗਤਾਨ ਹੈਂਡਆਫ ਪਲੇਸਹੋਲਡਰ ਪ੍ਰਾਪਤ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cliente recebe produtos selecionados, orçamento dividido e um espaço reservado para a transferência segura do pagamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клиент получает подобранные товары, смету на отдельные позиции и защищенный шаблон для передачи платежа."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வாடிக்கையாளர் தேர்ந்தெடுக்கப்பட்ட தயாரிப்புகள், பிரிக்கப்பட்ட ஒப்பந்தப்புள்ளி மதிப்பீடு மற்றும் பாதுகாப்பான கட்டணப் பரிமாற்றத்திற்கான மாதிரி ஆவணம் ஆகியவற்றைப் பெறுகிறார்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "క్లయింట్ ఎంపిక చేసిన ఉత్పత్తులు, విభజిత టెండర్ అంచనా మరియు సురక్షిత చెల్లింపు బదిలీ ప్లేస్‌హోల్డర్‌ను అందుకుంటారు."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户将收到精选产品、拆分投标估算和安全的付款交接占位符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客戶將收到精選產品、拆分投標估算和安全的付款交接佔位符。"
          }
        }
      }
    },
