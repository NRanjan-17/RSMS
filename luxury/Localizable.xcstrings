    "In a production environment, this would display the device camera capture interface." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في بيئة الإنتاج، سيؤدي هذا إلى عرض واجهة التقاط كاميرا الجهاز."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটা উৎপাদন পৰিৱেশত, ই ডিভাইচ কেমেৰা কেপচাৰ আন্তঃপৃষ্ঠ প্ৰদৰ্শন কৰিব।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রোডাকশন পরিবেশে, এটি ডিভাইসটির ক্যামেরা ক্যাপচার ইন্টারফেস প্রদর্শন করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer Produktionsumgebung würde hier die Benutzeroberfläche für die Kameraaufnahme des Geräts angezeigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un entorno de producción, esto mostraría la interfaz de captura de la cámara del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En environnement de production, cela afficherait l'interface de capture de la caméra de l'appareil."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઉત્પાદન વાતાવરણમાં, આ ઉપકરણ કેમેરા કેપ્ચર ઇન્ટરફેસ પ્રદર્શિત કરશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उत्पादन परिवेश में, यह डिवाइस कैमरा कैप्चर इंटरफ़ेस प्रदर्शित करेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In un ambiente di produzione, ciò visualizzerebbe l'interfaccia di acquisizione della fotocamera del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実稼働環境では、これはデバイスのカメラキャプチャインターフェースを表示します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉತ್ಪಾದನಾ ಪರಿಸರದಲ್ಲಿ, ಇದು ಸಾಧನದ ಕ್ಯಾಮೆರಾ ಕ್ಯಾಪ್ಚರ್ ಇಂಟರ್ಫೇಸ್ ಅನ್ನು ಪ್ರದರ್ಶಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 운영 환경에서는 기기의 카메라 캡처 인터페이스가 표시됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു പ്രൊഡക്ഷൻ പരിതസ്ഥിതിയിൽ, ഇത് ഉപകരണ ക്യാമറ ക്യാപ്‌ചർ ഇന്റർഫേസ് പ്രദർശിപ്പിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उत्पादन वातावरणात, हे डिव्हाइस कॅमेरा कॅप्चर इंटरफेस प्रदर्शित करेल."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏକ ଉତ୍ପାଦନ ପରିବେଶରେ, ଏହା ଡିଭାଇସ୍ କ୍ୟାମେରା କ୍ୟାପଚର ଇଣ୍ଟରଫେସ୍ ପ୍ରଦର୍ଶନ କରିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਕ ਉਤਪਾਦਨ ਵਾਤਾਵਰਣ ਵਿੱਚ, ਇਹ ਡਿਵਾਈਸ ਕੈਮਰਾ ਕੈਪਚਰ ਇੰਟਰਫੇਸ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੇਗਾ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num ambiente de produção, isto exibiria a interface de captura da câmara do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В производственной среде это отобразит интерфейс захвата изображения с камеры устройства."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உற்பத்திச் சூழலில், இது சாதனத்தின் கேமரா படப்பிடிப்பு இடைமுகத்தைக் காண்பிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఉత్పత్తి వాతావరణంలో, ఇది పరికరం యొక్క కెమెరా క్యాప్చర్ ఇంటర్‌ఫేస్‌ను ప్రదర్శిస్తుంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在生产环境中，这将显示设备摄像头捕获界面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在生產環境中，這將顯示設備攝影機擷取介面。"
          }
        }
      }
    },
