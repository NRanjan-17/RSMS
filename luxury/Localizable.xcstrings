    "You have unsaved changes. Are you sure you want to go back? Your changes will be lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك تغييرات غير محفوظة. هل أنت متأكد أنك تريد العودة؟ تغييراتك ستضيع."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have unsaved changes. Are you sure you want to go back? Your changes will be lost."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অসংরক্ষিত পরিবর্তনগুলি রয়েছে। আপনি কি নিশ্চিত যে আপনি ফিরে যেতে চান? আপনার পরিবর্তনগুলি হারিয়ে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have unsaved changes. Are you sure you want to go back? Your changes will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have unsaved changes. Are you sure you want to go back? Your changes will be lost."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez des modifications non enregistrées. Tu es sûr de vouloir revenir ? Vos changements seront perdus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી પાસે સંગ્રહ ન થયેલ ફેરફારો છે. શું તમે ખરેખર પાછા જવા માંગો છો? તમારા ફેરફારો નષ્ટ થઈ જશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास सहेजे नहीं गए परिवर्तन हैं. क्या आप वाकई वापस जाना चाहते हैं? आपके परिवर्तन खो जाएंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai le modifiche non salvate. Sei sicuro di voler tornare? I tuoi cambiamenti andranno persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have unsaved changes. Are you sure you want to go back? Your changes will be lost."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have unsaved changes. Are you sure you want to go back? Your changes will be lost."
          }
        },
        "ko" : {
