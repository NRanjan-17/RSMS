    "Align barcode within the frame to scan.\nIt will be added to the cart automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بمحاذاة الباركود داخل الإطار للمسح الضوئي.\nسيتم إضافتها تلقائيا إلى السلة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্কেন কৰিবলৈ ফ্ৰেমৰ ভিতৰত বাৰকোড সংৰেখিত কৰক।\nএইটো স্বয়ংক্ৰিয়ভাৱে কাৰ্টলৈ যোগ কৰা হ'ব।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্যান করতে ফ্রেমের মধ্যে বারকোড সারিবদ্ধ করুন।\nএটি স্বয়ংক্রিয়ভাবে কার্টে যুক্ত হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richten Sie den Barcode innerhalb des Rahmens zum Scannen aus.\nEs wird automatisch in den Warenkorb gelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Align barcode within the frame to scan.\nIt will be added to the cart automatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alignez le code-barres dans le cadre pour scanner.\nIl sera ajouté automatiquement au panier."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સ્કેન કરવા માટે ફ્રેમની અંદર બારકોડને ગોઠવો.\nતે આપમેળે કાર્ટમાં ઉમેરવામાં આવશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन करने के लिए फ्रेम के भीतर बारकोड को संरेखित करें।\nयह स्वचालित रूप से कार्ट में जुड़ जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allinea il codice a barre all'interno del frame per scansionare.\nVerrà aggiunto automaticamente al carrello."
          }
        },
