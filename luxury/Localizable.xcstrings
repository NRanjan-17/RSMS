    "Manager approval required for courtesy above %@." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موافقة المدير مطلوبة للإشارة إلى ما سبق %@."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ৰ ওপৰৰ সৌজন্যতাৰ বাবে পৰিচালকৰ অনুমোদনৰ প্ৰয়োজন।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ এর উপরের সৌজন্যের জন্য ম্যানেজারের অনুমোদন প্রয়োজন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die oben genannten Höflichkeitsgesten ist die Zustimmung des Managers erforderlich %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere la aprobación del gerente para la cortesía anterior %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'approbation du responsable est requise pour la courtoisie ci-dessus %@."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઉપરોક્ત સૌજન્ય માટે મેનેજરની મંજૂરી જરૂરી છે %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर दिए गए शिष्टाचार के लिए प्रबंधक की स्वीकृति आवश्यक है %@।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È necessaria l'approvazione del responsabile per la cortesia di cui sopra %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 以上の礼儀にはマネージャーの承認が必要です。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ಮೇಲಿನ ಸೌಜನ್ಯಕ್ಕಾಗಿ ವ್ಯವಸ್ಥಾಪಕರ ಅನುಮೋದನೆ ಅಗತ್ಯವಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 예의를 갖추려면 관리자의 승인이 필요합니다 %@."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ എന്നതിന് മുകളിലുള്ള മര്യാദയ്ക്ക് മാനേജരുടെ അനുമതി ആവശ്യമാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वरील सौजन्यासाठी व्यवस्थापकाची मंजुरी आवश्यक आहे %@."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଉପରୋକ୍ତ ସୌଜନ୍ୟ ପାଇଁ ପରିଚାଳକଙ୍କ ଅନୁମୋଦନ ଆବଶ୍ୟକ %@।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਪਰੋਕਤ ਸ਼ਿਸ਼ਟਾਚਾਰ ਲਈ ਮੈਨੇਜਰ ਦੀ ਪ੍ਰਵਾਨਗੀ ਦੀ ਲੋੜ ਹੈ %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessária a aprovação do gerente para a cortesia acima %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для соблюдения вышеуказанных правил вежливости требуется одобрение менеджера %@."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மேலே உள்ள %@ க்கு மேலாளரின் ஒப்புதல் தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పైన పేర్కొన్న మర్యాద కోసం మేనేజర్ ఆమోదం అవసరం %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以上礼节需要经理批准 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以上禮節需經理批准 %@。"
          }
        }
      }
    },
