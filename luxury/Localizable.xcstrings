    "A password reset link has been sent to your email address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إرسال رابط إعادة تعيين كلمة المرور إلى عنوان بريدك الإلكتروني."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপোনাৰ ইমেইল ঠিকনালৈ এটা পাছৱৰ্ড ৰিছেট লিংক প্ৰেৰণ কৰা হৈছে।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ইমেল ঠিকানায় একটি পাসওয়ার্ড রিসেট লিঙ্ক পাঠানো হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Link zum Zurücksetzen Ihres Passworts wurde an Ihre E-Mail-Adresse gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha enviado un enlace para restablecer la contraseña a su dirección de correo electrónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien de réinitialisation de mot de passe a été envoyé à votre adresse électronique."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા ઇમેઇલ સરનામાં પર પાસવર્ડ રીસેટ લિંક મોકલવામાં આવી છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके ईमेल पते पर पासवर्ड रीसेट करने का लिंक भेज दिया गया है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un link per reimpostare la password è stato inviato al tuo indirizzo email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードリセット用のリンクがお客様のメールアドレスに送信されました。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಇಮೇಲ್ ವಿಳಾಸಕ್ಕೆ ಪಾಸ್‌ವರ್ಡ್ ಮರುಹೊಂದಿಸುವ ಲಿಂಕ್ ಅನ್ನು ಕಳುಹಿಸಲಾಗಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호 재설정 링크가 귀하의 이메일 주소로 전송되었습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ഇമെയിൽ വിലാസത്തിലേക്ക് ഒരു പാസ്‌വേഡ് പുനഃസജ്ജീകരണ ലിങ്ക് അയച്ചിട്ടുണ്ട്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या ईमेल पत्त्यावर पासवर्ड रीसेट करण्याची लिंक पाठवण्यात आली आहे."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ଇମେଲ୍ ଠିକଣାକୁ ପାସୱାର୍ଡ ପୁନଃସେଟ୍ ଲିଙ୍କ୍ ପଠାଯାଇଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ ਈਮੇਲ ਪਤੇ 'ਤੇ ਇੱਕ ਪਾਸਵਰਡ ਰੀਸੈਟ ਲਿੰਕ ਭੇਜਿਆ ਗਿਆ ਹੈ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi enviado um link para redefinição de palavra-passe para o seu endereço de e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылка для сброса пароля отправлена на ваш адрес электронной почты."
