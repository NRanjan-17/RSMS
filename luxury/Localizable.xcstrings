    "Duplicate catalog detected! A catalog with this barcode already exists." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اكتشاف كتالوج مكرر! هناك بالفعل كتالوج يحتوي على هذا الرمز الشريطي."
