    "Mismatch detected. Submit the scanned quantity to correct inventory." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اكتشاف عدم تطابق. يرجى إرسال الكمية الممسوحة ضوئياً إلى المخزون الصحيح."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মিছমেচ ধৰা পৰিল। স্কেন কৰা পৰিমাণটো তথ্য-পাতি সঠিক কৰিবলৈ জমা দিয়ক।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অমিল শনাক্ত করা হয়েছে। ইনভেন্টরি সংশোধনের জন্য স্ক্যান করা পরিমাণ জমা দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abweichung festgestellt. Bitte die gescannte Menge dem korrekten Lagerbestand zuweisen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha detectado una discrepancia. Envíe la cantidad escaneada al inventario correcto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incohérence détectée. Veuillez soumettre la quantité scannée à l'inventaire correct."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મેળ ખાતો નથી. સ્કેન કરેલો જથ્થો સુધારવા માટે સબમિટ કરો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विसंगति पाई गई। स्कैन की गई मात्रा को इन्वेंट्री में सही करने के लिए सबमिट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevata discrepanza. Inviare la quantità scansionata all'inventario corretto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不一致が検出されました。スキャンした数量を正しい在庫情報に送信してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೊಂದಿಕೆಯಾಗದಿರುವುದು ಪತ್ತೆಯಾಗಿದೆ. ದಾಸ್ತಾನು ಸರಿಪಡಿಸಲು ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಪ್ರಮಾಣವನ್ನು ಸಲ್ಲಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불일치가 감지되었습니다. 스캔한 수량을 정확한 재고에 제출하십시오."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പൊരുത്തക്കേട് കണ്ടെത്തി. ഇൻവെന്ററി ശരിയാക്കാൻ സ്കാൻ ചെയ്ത അളവ് സമർപ്പിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तफावत आढळली आहे. स्कॅन केलेली संख्या योग्य इन्व्हेंटरीमध्ये सबमिट करा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମେଳ ଖାଉନାହିଁ। ସ୍କାନ ହୋଇଥିବା ପରିମାଣକୁ ସଂଶୋଧନ ଇନଭେଣ୍ଟରୀ ପାଇଁ ଦାଖଲ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੇਲ ਨਹੀਂ ਖਾਂਦਾ। ਸਕੈਨ ਕੀਤੀ ਮਾਤਰਾ ਨੂੰ ਸਹੀ ਵਸਤੂ ਸੂਚੀ ਲਈ ਜਮ੍ਹਾਂ ਕਰੋ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incompatibilidade detectada. Envie a quantidade digitalizada para o stock correto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обнаружено несоответствие. Отправьте отсканированное количество в соответствующий инвентарный отдел."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பொருந்தாமை கண்டறியப்பட்டது. ஸ்கேன் செய்யப்பட்ட அளவைச் சரியான இருப்புப் பட்டியலில் சமர்ப்பிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సరిపోలనితనం కనుగొనబడింది. స్కాన్ చేసిన పరిమాణాన్ని సరైన ఇన్వెంటరీకి సమర్పించండి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到不匹配。请提交扫描数量以更正库存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢測到不匹配。請提交掃描數量以更正庫存。"
          }
        }
      }
    },
