    "Your device is not configured to send emails. Please set up the Apple Mail app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهازك غير مُهيأ لإرسال رسائل البريد الإلكتروني. يُرجى إعداد تطبيق Apple Mail."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপোনাৰ ডিভাইচ ইমেইল প্ৰেৰণ কৰিবলে বিন্যাস কৰা হোৱা নাই। অনুগ্ৰহ কৰি এপল মেইল এপটো ছেট আপ কৰক।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ডিভাইসটি ইমেল পাঠানোর জন্য কনফিগার করা নেই। অনুগ্রহ করে অ্যাপল মেইল অ্যাপটি সেট আপ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Gerät ist nicht für den E-Mail-Versand konfiguriert. Bitte richten Sie die Apple Mail-App ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo no está configurado para enviar correos electrónicos. Configura la aplicación Mail de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre appareil n'est pas configuré pour envoyer des e-mails. Veuillez configurer l'application Mail d'Apple."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારું ઉપકરણ ઇમેઇલ મોકલવા માટે ગોઠવેલું નથી. કૃપા કરીને Apple Mail ઍપ સેટ કરો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके डिवाइस में ईमेल भेजने की सेटिंग नहीं है। कृपया Apple Mail ऐप सेट अप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo dispositivo non è configurato per inviare email. Configura l'app Mail di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのデバイスはメール送信の設定がされていません。Apple Mailアプリを設定してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಸಾಧನವನ್ನು ಇಮೇಲ್‌ಗಳನ್ನು ಕಳುಹಿಸಲು ಕಾನ್ಫಿಗರ್ ಮಾಡಲಾಗಿಲ್ಲ. ದಯವಿಟ್ಟು Apple ಮೇಲ್ ಅಪ್ಲಿಕೇಶನ್ ಅನ್ನು ಹೊಂದಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 기기는 이메일을 보낼 수 있도록 설정되어 있지 않습니다. Apple Mail 앱을 설정해 주세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇമെയിലുകൾ അയയ്ക്കാൻ നിങ്ങളുടെ ഉപകരണം കോൺഫിഗർ ചെയ്തിട്ടില്ല. Apple മെയിൽ ആപ്പ് സജ്ജമാക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचे डिव्हाइस ईमेल पाठवण्यासाठी कॉन्फिगर केलेले नाही. कृपया ॲपल मेल ॲप सेट करा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ଡିଭାଇସ୍‌ଟି ଇମେଲ୍‌ ପଠାଇବା ପାଇଁ ବିନ୍ୟାସିତ ହୋଇନାହିଁ। ଦୟାକରି Apple Mail ଆପ୍‌ ସେଟ୍‌ ଅପ୍‌ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡਾ ਡੀਵਾਈਸ ਈਮੇਲ ਭੇਜਣ ਲਈ ਕੌਂਫਿਗਰ ਨਹੀਂ ਕੀਤਾ ਗਿਆ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ Apple Mail ਐਪ ਸੈੱਟ ਅੱਪ ਕਰੋ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu dispositivo não está configurado para enviar e-mails. Configure a aplicação Mail da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше устройство не настроено для отправки электронных писем. Пожалуйста, настройте приложение Apple Mail."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சாதனம் மின்னஞ்சல்களை அனுப்பும் வகையில் உள்ளமைக்கப்படவில்லை. தயவுசெய்து ஆப்பிள் மெயில் செயலியை அமைக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ పరికరం ఇమెయిల్‌లను పంపడానికి కాన్ఫిగర్ చేయబడలేదు. దయచేసి ఆపిల్ మెయిల్ యాప్‌ను సెటప్ చేయండి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的设备尚未配置为发送电子邮件。请设置 Apple Mail 应用。"
