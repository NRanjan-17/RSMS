    "Client receives curated products, split tender estimate, and secure payment handoff placeholder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل العميل على منتجات مختارة وتقدير للعطاءات مقسمة، وتسليم مؤقت للدفعات آمن."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Client receives curated products, split tender estimate, and secure payment handoff placeholder."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্লায়েন্ট কিউরেটেড পণ্য, স্প্লিট টেন্ডার এস্টিমেট এবং নিরাপদ পেমেন্ট হ্যান্ডঅফ প্লেসহোল্ডার গ্রহণ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Client receives curated products, split tender estimate, and secure payment handoff placeholder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Client receives curated products, split tender estimate, and secure payment handoff placeholder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le client reçoit des produits sélectionnés, une estimation d’appel d’offres fractionnée et un placement provisoire sécurisé pour le transfert de paiement."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ક્લાયંટ ક્યુરેટેડ પ્રોડક્ટ્સ, સ્પ્લિટ ટેન્ડર અંદાજ અને સુરક્ષિત ચુકવણી હેન્ડઓફ પ્લેસહોલ્ડર મેળવે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्राहक क्यूरेटेड उत्पाद, विभाजित निविदा अनुमान, और सुरक्षित भुगतान हैंडऑफ प्लेसहोल्डर प्राप्त करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cliente riceve prodotti selezionati, una stima di offerta divisa e un segnaposto di consegna del pagamento sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
